+        { kind: 'groq', apiKey: 'g' },
+        { kind: 'claude', apiKey: 'c', enabled: false },
+        { kind: 'gemini', apiKey: 'x' },
+      ],
+      usage: { load: () => store, save: (u) => (store = u) },
