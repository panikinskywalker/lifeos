+import type { LLMProvider } from '@core/ai/provider';
+import { buildAgentProviders, PROVIDER_PRESETS, type ChainEvents, type ProviderConfig } from '@core/ai/providers';
+import { useSettings } from '@ui/hooks/useSettings';
+import { getProviderKey } from './boot';
+
+/**
+ * Builds the agent's provider stack from settings + SecureStore keys:
+ *   chain(groq > gemini > claude…) each wrapped in a usage meter that persists
+ *   to settings.aiUsage and enforces settings.aiMonthlyCaps.
+ * Returns null when no provider in the chain has a usable key.
+ */
+export async function buildProvidersFromSettings(events?: ChainEvents): Promise<{ main: LLMProvider; small: LLMProvider; active: ProviderConfig[] } | null> {
+  const s = useSettings.getState();
+  const withKeys: ProviderConfig[] = [];
+  for (const c of s.aiChain) {
+    if (c.enabled === false) continue;
+    const preset = PROVIDER_PRESETS[c.kind];
+    const apiKey = preset.needsKey ? await getProviderKey(c.kind) : undefined;
+    if (preset.needsKey && !apiKey) continue; // silently skip providers without a key
+    withKeys.push({ ...c, apiKey: apiKey ?? undefined });
+  }
+  if (!withKeys.length) return null;
+
+  const month = new Date().toISOString().slice(0, 7);
+  const usage = {
+    load: () => {
+      const u = useSettings.getState().aiUsage;
+      return u.month === month ? { ...u.byProvider } : {};
+    },
+    save: (byProvider: Record<string, import('@core/ai/providers').UsageRecord>) => useSettings.getState().set('aiUsage', { month, byProvider }),
+    monthlyTokenCap: (provider: string) => useSettings.getState().aiMonthlyCaps[provider],
+  };
+  const { main, small } = buildAgentProviders({ chain: withKeys, usage, events });
+  return { main, small, active: withKeys.map((c) => ({ ...c, apiKey: undefined })) };
+}
