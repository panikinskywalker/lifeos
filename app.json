{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "version": "0.0.3",
    "scheme": "lifeos",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F3EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lifeos.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "LifeOS attaches photos and receipts to your records.",
        "NSCameraUsageDescription": "LifeOS lets you photograph receipts and documents."
      }
    },
    "android": {
      "package": "app.lifeos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "LifeOS attaches photos and receipts to your records."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./modules/lifeos-device/app.plugin.js",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "LifeOS adds the contacts you pick to People."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "LifeOS shows your events and links them to the people and places in them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db32f19a-c1a6-475e-8875-558fe563760f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db32f19a-c1a6-475e-8875-558fe563760f"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
